      {"name": "糖", "amount": "1tbsp", "substitutes": []},
      {"name": "料酒", "amount": "1tbsp", "substitutes": ["干雪利酒 Dry Sherry 1tbsp"]},
      {"name": "玉米淀粉", "amount": "1tbsp", "substitutes": ["土豆淀粉 Potato starch"]},
