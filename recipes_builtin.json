    ],
    "equipment": ["炒锅 Wok", "平底锅 Skillet（替代）"],
    "steps": [
      {"order": 1, "action": "鸡肉切1.5cm丁，用1tbsp生抽+料酒+淀粉腌制15分钟", "duration": 15, "warning": "腌制是关键！肉嫩不嫩就看这步"},
